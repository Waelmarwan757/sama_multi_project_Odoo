<odoo>
    <data>
        <record id="hr_payslip_view_form" model="ir.ui.view">
            <field name="name">hr.payslip.form</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="hr_incentives" string="Incentives">
                        <group>
                            <group>
                                <field name="bonus_amount"/>
                            </group>
                            <group>
                                <field name="penalty_amount"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>