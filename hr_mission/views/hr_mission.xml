<odoo>
    <record id="view_hr_mission_form" model="ir.ui.view">
        <field name="name">hr.mission.form</field>
        <field name="model">hr.mission</field>
        <field name="arch" type="xml">
            <form string="HR Mission">
                <header>
                    <button name="action_submit" string="Submit" type="object" invisible="state != 'draft' or not id"
                        class="btn-primary"/>
                    <!-- Manager Approval -->
                    <button name="action_manager_approve" string="Confirm" type="object" invisible="state != 'confirmed'" class="btn-primary" groups="hr_mission.group_hr_mission_officer"/>
                    <button name="action_reject" id="manager_reject" string="Reject" type="object" invisible="state != 'confirmed'" class="btn-secondary" groups="hr_mission.group_hr_mission_officer"/>
                    <!-- HR Approval -->
                    <button name="action_hr_approve" string="Approve" type="object" invisible="state != 'manager_approved'" class="btn-primary" groups="hr_mission.group_hr_mission_manager"/>
                    <button name="action_reject" id="hr_reject" string="Reject" type="object" invisible="state != 'manager_approved'" class="btn-secondary" groups="hr_mission.group_hr_mission_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'hr_approved'" groups="hr_mission.group_hr_mission_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Employee Information">
                            <field name="employee_id" invisible="1" force_save="1"/>
                            <field name="employee_id" groups="hr_mission.group_hr_mission_officer" readonly="state != 'draft'"/>
                            <field name="department_id"/>
                            <field name="current_location_id"/>
                            <field name="manager_id"/>
                        </group>
                        <group string="Mission Details">
                            <field name="mission_type" readonly="state != 'draft'"/>
                            <field name="end_date" invisible="1"/>
                            <field name="start_date"
                                   string="Mission Period"
                                   widget="daterange"
                                   options="{'end_date_field': 'end_date'}"
                                   readonly="state != 'draft'"
                                   />
                            <field name="destination" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <group>
                                <field name="note" readonly="state != 'draft'"/>
                                <field name="manager_reason" groups="hr_mission.group_hr_mission_officer" required="1" invisible="state == 'draft'" readonly="state != 'confirmed'"/>
                                <field name="hr_reason" groups="hr_mission.group_hr_mission_manager" required="1" invisible="state in ['draft', 'confirmed']" readonly="state != 'manager_approved'"/>
                            </group>
                        </page>
                        <page string="Attendance Records" groups="hr_mission.group_hr_mission_manager">
                            <field name="attendance_ids">
                                <list string="Attendance Records">
                                    <field name="check_in"/>
                                    <field name="check_out"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_mission_list" model="ir.ui.view">
        <field name="name">hr.mission.list</field>
        <field name="model">hr.mission</field>
        <field name="arch" type="xml">
            <list string="HR Missions">
                <field name="employee_id"/>
                <field name="mission_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="destination"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_hr_mission" model="ir.actions.act_window">
        <field name="name">HR Missions</field>
        <field name="res_model">hr.mission</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_mission" name="Missions" parent="hr.menu_hr_root" action="action_hr_mission" sequence="10"/>
</odoo>
