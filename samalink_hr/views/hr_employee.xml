<odoo>
    <data>
        <record id="view_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <group name="identification_group" position="inside">
                    <field name="allow_check_from_odoo"/>
                </group>
                <header position="inside">
                    <button name="action_generate_absent_entries" string="Generate Absent Entries" type="object"/>
                </header>
                <div name="button_box" position="inside">
                    <button type="object" class="oe_stat_button" id="action_view_absent_entries" icon="fa-calendar-times-o" name="action_view_absent_entries">
                        <div class="o_stat_info">
                            <span class="o_stat_text">
                            Absent Entries
                            </span>
                        </div>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>