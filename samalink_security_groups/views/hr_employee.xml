<odoo>
    <record id="action_open_my_employee" model="ir.actions.server">
        <field name="name">My Info</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">action = env['hr.employee'].action_open_my_employee()</field>
    </record>

    <menuitem id="hr_employee_menu_my_info"
              name="My Info"
              action="action_open_my_employee"
              sequence="10"/>
</odoo>