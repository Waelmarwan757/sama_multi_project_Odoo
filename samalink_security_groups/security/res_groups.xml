<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_samalink_hr">
            <field name="name">SamaLink HR</field>
        </record>
        <record id="group_samalink_employee" model="res.groups">
            <field name="name">SamaLink Employee</field>
            <field name="category_id" ref="module_category_samalink_hr" />
            <field name="implied_ids" eval="[
                (4, ref('hr_attendance.group_hr_attendance_own_reader')),
            ]" />
            <field name="whitelisted_menu_ids" eval="[
                (4, ref('mail.menu_root_discuss')),
                (4, ref('hr_holidays.hr_leave_menu_new_request')),
                (4, ref('samalink_security_groups.menu_my_attendances')),
                (4, ref('samalink_security_groups.menu_my_payslips')),
                (4, ref('samalink_security_groups.hr_employee_menu_my_info')),
            ]" />
            <field name="menu_access" eval="[
                (4, ref('samalink_security_groups.menu_my_attendances')),
                (4, ref('samalink_security_groups.menu_my_payslips')),
                (4, ref('samalink_security_groups.hr_employee_menu_my_info')),
            ]" />
        </record>
        <record id="group_samalink_hr_manager" model="res.groups">
            <field name="name">SamaLink HR Manager</field>
            <field name="category_id" ref="module_category_samalink_hr" />
            <field name="implied_ids" eval="[
                (4, ref('group_samalink_employee')),
                (4, ref('hr_holidays.group_hr_holidays_user')),
            ]" />
            <field name="whitelisted_menu_ids" eval="[
                (4, ref('menu_hr_leave_waiting_1st_approve')),
            ]" />
            <field name="menu_access" eval="[
                (4, ref('menu_hr_leave_waiting_1st_approve')),
            ]" />
        </record>
        <record id="group_samalink_hr_officer" model="res.groups">
            <field name="name">SamaLink HR Officer</field>
            <field name="category_id" ref="module_category_samalink_hr" />
            <field name="implied_ids" eval="[
                (4, ref('group_samalink_employee')),
                (4, ref('hr_holidays.group_hr_holidays_user')),
                (4, ref('hr.group_hr_user')),
                (4, ref('hr_attendance.group_hr_attendance_manager')),
                (4, ref('hr_payroll_community.group_hr_payroll_community_manager')),
            ]" />
            <field name="whitelisted_menu_ids" eval="[
                (4, ref('menu_hr_leave_waiting_2nd_approve')),
                (4, ref('hr_attendance.menu_hr_attendance_view_attendances')),
                (4, ref('hr_payroll_community.menu_department_tree')),
                (4, ref('hr_payroll_community.menu_hr_payslip_run')),
                (4, ref('hr_payroll_community.menu_hr_payroll_community_configuration')),
            ]" />
            <field name="menu_access" eval="[
                (4, ref('menu_hr_leave_waiting_2nd_approve')),
            ]" />
        </record>
        <record id="group_samalink_hr_accountant" model="res.groups">
            <field name="name">SamaLink HR Accountant</field>
            <field name="category_id" ref="module_category_samalink_hr" />
            <field name="implied_ids" eval="[
                (4, ref('group_samalink_employee')),
                (4, ref('hr_payroll_community.group_hr_payroll_community_manager')),
            ]" />
            <field name="whitelisted_menu_ids" eval="[
                (4, ref('hr_payroll_community.menu_hr_payslip_run')),
                (4, ref('hr_payroll_community.menu_department_tree')),
            ]" />
        </record>
    </data>
</odoo>