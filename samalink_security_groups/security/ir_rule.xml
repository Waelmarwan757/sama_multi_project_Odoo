<odoo>
    <record id="hr_payslip_line_rule_group_samalink_employee" model="ir.rule">
        <field name="name">Payslip Line Samalink Employee (Own Lines)</field>
        <field name="model_id" ref="hr_payroll_community.model_hr_payslip_line"/>
        <field name="groups" eval="[(4, ref('samalink_security_groups.group_samalink_employee'))]"/>
        <field name="domain_force">
            [('slip_id.employee_id.user_id', '=', user.id)]
        </field>
    </record>

    <record id="hr_payslip_line_rule_group_samalink_hr_accountant" model="ir.rule">
        <field name="name">Payslip Line Samalink HR Accountant (All Lines)</field>
        <field name="model_id" ref="hr_payroll_community.model_hr_payslip_line"/>
        <field name="groups" eval="[(4, ref('samalink_security_groups.group_samalink_hr_accountant'))]"/>
        <field name="domain_force">
            [(1, '=', 1)]
        </field>
    </record>

    <record id="hr_employee_rule_group_samalink_hr_manager" model="ir.rule">
        <field name="name">HR Employee Samalink HR Manager (Team Employees)</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('samalink_security_groups.group_samalink_hr_manager'))]"/>
        <field name="domain_force">
            ['|', ('parent_id', '=', user.employee_id.id), ('user_id', '=', user.id)]
        </field>
    </record>
</odoo>