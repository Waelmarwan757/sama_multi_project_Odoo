<odoo>
    <record id="view_zk_api_form" model="ir.ui.view">
        <field name="name">zk.api.form</field>
        <field name="model">zk.api</field>
        <field name="arch" type="xml">
            <form string="ZK API">
                <header>
                    <button name="action_sync_departments" string="Sync Departments"
                            type="object" class="oe_highlight"/>
                    <button name="action_sync_attendance" string="Sync Attendance"
                        type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="url"/>
                        <field name="username"/>
                        <field name="password"/>
                        <field name="token"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zk_api_list" model="ir.ui.view">
        <field name="name">zk.api.list</field>
        <field name="model">zk.api</field>
        <field name="arch" type="xml">
            <list string="ZK API">
                <field name="name"/>
                <field name="url"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_zk_api" model="ir.actions.act_window">
        <field name="name">ZK API</field>
        <field name="res_model">zk.api</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_zk_api" name="APIs" parent="menu_zk_api_root" action="action_zk_api" sequence="10"/>
</odoo>